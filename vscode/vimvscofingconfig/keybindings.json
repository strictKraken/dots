[
  // handle <C-d><C-u> because native neovim plugin can't move cursor when scroll a half of window
  {
    "key": "ctrl+d",
    "command": "vscode-neovim.send",
    "args": "<c-d>",
    "when": "editorTextFocus && neovim.init"
  },
  {
    "key": "ctrl+u",
    "command": "vscode-neovim.send",
    "args": "<c-u>",
    "when": "editorTextFocus && neovim.init"
  },
  // Use escape for focus to active editor group
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "!editorTextFocus"
  }
]
